{
    "name": "proust/mutation-oracle",
    "description": "Fixture pinning proust --mutate against Infection for the V1 mutator set.",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "infection/infection": "^0.29"
    },
    "autoload": {
        "psr-4": {
            "Oracle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oracle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
