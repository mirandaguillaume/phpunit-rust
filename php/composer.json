{
    "name": "proust/worker",
    "type": "project",
    "description": "FrankenPHP worker that executes PHPUnit tests on behalf of proust",
    "autoload": {
        "psr-4": {
            "Proust\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Proust\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
