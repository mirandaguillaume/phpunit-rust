{
    "name": "phpunit-rust/worker",
    "type": "project",
    "description": "FrankenPHP worker that executes PHPUnit tests on behalf of phpunit-rust",
    "autoload": {
        "psr-4": {
            "PhpunitRust\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpunitRust\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
